{
  "name": "noted",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Markdown notes. Buildless static SPA — zero runtime dependencies, all libraries from CDN.",
  "scripts": {
    "dev": "serve -s .",
    "start": "serve -s .",
    "deploy": "bash deploy.sh",
    "check:shell": "node tools/check-shell.mjs",
    "test": "playwright test",
    "test:shell": "node tools/check-shell.mjs && playwright test"
  },
  "devDependencies": {
    "serve": "^14.2.4",
    "@playwright/test": "^1.63.0",
    "jszip": "^3.10.0"
  }
}